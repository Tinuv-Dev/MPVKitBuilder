--- a/video/out/vulkan/context_ios.m
+++ b/video/out/vulkan/context_ios.m
@@ -112,6 +112,23 @@ static bool ios_vk_init(struct ra_ctx *ctx)
     return false;
 }
 
+// Surface size resolution order: explicit option (set by the host via
+// `set ios-surface-size WxH` in response to a rotation / bounds change) takes
+// precedence over the layer's drawableSize, because MoltenVK on iOS will
+// silently rebuild the swapchain when the CAMetalLayer's drawableSize changes
+// without ever returning VK_SUBOPTIMAL_KHR / VK_ERROR_OUT_OF_DATE_KHR, so the
+// option write is the only authoritative signal that the host has resized.
+static void ios_vk_resolve_size(struct ra_ctx *ctx, CAMetalLayer *layer, int *w, int *h)
+{
+    struct m_geometry g = ctx->vo->opts->ios_surface_size;
+    if (g.w > 0 && g.h > 0) {
+        *w = g.w;
+        *h = g.h;
+        return;
+    }
+    ios_vk_get_pixel_size(layer, w, h);
+}
+
 static bool ios_vk_reconfig(struct ra_ctx *ctx)
 {
     struct priv *p = ctx->priv;
@@ -121,7 +138,7 @@ static bool ios_vk_reconfig(struct ra_ctx *ctx)
         return false;
 
     int w, h;
-    ios_vk_get_pixel_size(p->layer, &w, &h);
+    ios_vk_resolve_size(ctx, p->layer, &w, &h);
     return ra_vk_ctx_resize(ctx, w, h);
 }
 
